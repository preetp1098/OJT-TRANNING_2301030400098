<!DOCTYPE html>
<html>
<head>
    <title>CSS Types Example</title>

    <style>
        h2 {
            color: blue;
            background-color: lightgray;
            padding: 10px;
        }

        .internal-box {
            border: 2px solid black;
            margin: 20px;
            padding: 15px;
            font-size: 18px;
        }
    </style>

    <link rel="stylesheet" href="practical 4.css">
</head>

<body>

    <h1>Types of CSS</h1>
    <p style="color:red; background-color:rgb(22, 19, 206); font-size:20px;">
        This paragraph uses Inline CSS.
    </p>

    <h2>This heading uses Internal CSS</h2>
    <div class="internal-box">
        This box is styled using Internal CSS.
    </div>

    <div class="external-box">
        This box is styled using External CSS.
    </div>

</body>
</html>





