<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-commerce website</title>
    <style> 
      @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#f3f4f6;
}


.header{
    background:#0f0f0f;
    padding:18px 60px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 4px 20px rgba(0,0,0,0.2);
}

.logo{
    width:120px;
    height:auto;
    object-fit:contain;
    display:block;
}


.middle{
    display:flex;
    align-items:center;
    gap:35px;
}


.middle button{
    background:none;
    border:none;
    color:#d1d5db;
    font-size:15px;
    font-weight:500;
    cursor:pointer;
    transition:0.3s;
    position:relative;
}


.middle button::after{
    content:'';
    position:absolute;
    left:0;
    bottom:-6px;
    width:0%;
    height:2px;
    background:#3b82f6;
    transition:0.3s;
}

.middle button:hover{
    color:white;
}

.middle button:hover::after{
    width:100%;
}


.content{
    display:flex;
    align-items:center;
    gap:15px;
}

.content button{
    padding:10px 18px;
    border-radius:8px;
    border:none;
    cursor:pointer;
    font-size:14px;
    font-weight:500;
    transition:0.3s;
}

.content button:first-child{
    background:#1f2937;
    color:white;
}

.content button:last-child{
    background:#2563eb;
    color:white;
}


.content button:hover{
    transform:translateY(-2px);
    opacity:0.9;
}


.category-table{
    width:90%;
    margin:50px auto;
    border-collapse:collapse;
    background:white;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 8px 30px rgba(0,0,0,0.08);
}


.category-table th{
    background:#111827;
    color:white;
    padding:20px;
    font-size:15px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:1px;
}

.category-table td{
    padding:18px;
    text-align:center;
    color:#374151;
    font-size:14px;
    border-bottom:1px solid #e5e7eb;
}


.category-table tr:nth-child(even){
    background:#f9fafb;
}


.category-table tr:hover{
    background:#eff6ff;
    transition:0.3s;
}


.category-table img{
    width:120px;
    height:120px;
    object-fit:cover;
    border-radius:12px;
}


.category-table td{
    vertical-align:middle;
}

.slider-container{
    width:90%;
    height:450px;
    margin:40px auto;
    position:relative;
    overflow:hidden;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,0.2);
    background:white;
}

.slides{
    display:none;
    width:100%;
    height:100%;
}

.slides img{
    width:100%;
    height:450px;
    object-fit:contain;
    background:white;
}

.prev,
.next{
    cursor:pointer;
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    padding:16px;
    color:white;
    font-size:24px;
    font-weight:bold;
    background:rgba(0,0,0,0.5);
    user-select:none;
    border-radius:50%;
}

.prev{
    left:20px;
}

.next{
    right:20px;
}

.prev:hover,
.next:hover{
    background:black;
}

.dots-box{
    text-align:center;
    margin-top:15px;
}

.dot{
    height:14px;
    width:14px;
    margin:0 5px;
    background:#bbb;
    border-radius:50%;
    display:inline-block;
    cursor:pointer;
}

.active,
.dot:hover{
    background:#2563eb;
}

.fade{
    animation:fade 1s;
}

@keyframes fade{
    from{opacity:0.4}
    to{opacity:1}
}
</style>
</head>
<body>
    <div class="header">
     <img src="data:image/png;base64," alt="Logo" class="logo">
        <div class=" content">
            <button>Log in</button>
            <button>Start for free</button>
        </div>
        <div class="middle">
            <button>Product</button>
            <button>Why shopify?</button>
            <button>Pricing</button>
            <button>Enterprise</button>
        </div>

    </div>
<div class="slider-container">

    <div class="slides fade">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcScjZO9JwGY6IMUEHUxA3c6UCNEtfx0jF3C1oJItqZO_A&s">
    </div>

    <div class="slides fade">
        <img src="https://juniperfashion.com/cdn/shop/files/SS26_MOBILE_BANNER_jpg_fbe92ba1-627e-41e7-a792-76695adbbeea.jpg?v=1778265314&width=3000">
    </div>

    <div class="slides fade">
        <img src="https://hips.hearstapps.com/hmg-prod/images/mhl-opener-run-shoes-311-67edd9f20e75a.jpg?crop=0.655xw:0.983xh;0.168xw,0&resize=1120:*">
    </div>

    <div class="slides fade">
        <img src="https://wildcraft.com/media/mageplaza/blog/post/f/i/five_types_of_luggage_bags.jpg">
    </div>

    <div class="slides fade">
        <img src="https://www.gonoise.com/cdn/shop/files/Artboard_4_result_bd8eb80f-2271-4244-a58a-7b4d3946346d.webp?v=1749101195">
    </div>
    


    <a class="prev" onclick="plusSlides(-1)">❮</a>
    <a class="next" onclick="plusSlides(1)">❯</a>

</div>


<div class="dots-box">
    <span class="dot" onclick="currentSlide(1)"></span>
    <span class="dot" onclick="currentSlide(2)"></span>
    <span class="dot" onclick="currentSlide(3)"></span>
    <span class="dot" onclick="currentSlide(4)"></span>
    <span class="dot" onclick="currentSlide(5)"></span>
</div>
    <table class="category-table">
    <tr>
        <th>Image</th>
        <th>Category</th>
        <th>Products</th>
        <th>Price Range</th>
        <th>Availability</th>
    </tr>

    <tr>
        <td>
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcScjZO9JwGY6IMUEHUxA3c6UCNEtfx0jF3C1oJItqZO_A&s">
        </td>
        <td>Clothes</td>
        <td>T-Shirts, Jeans, Hoodies</td>
        <td>₹500 - ₹3000</td>
        <td>Available</td>
    </tr>

    <tr>
        <td>
            <img src="https://juniperfashion.com/cdn/shop/files/SS26_MOBILE_BANNER_jpg_fbe92ba1-627e-41e7-a792-76695adbbeea.jpg?v=1778265314&width=3000">
        </td>
        <td>Fashion</td>
        <td>Women Collection, Dresses</td>
        <td>₹700 - ₹5000</td>
        <td>Available</td>
    </tr>

    <tr>
        <td>
            <img src="https://hips.hearstapps.com/hmg-prod/images/mhl-opener-run-shoes-311-67edd9f20e75a.jpg?crop=0.655xw:0.983xh;0.168xw,0&resize=1120:*">
        </td>
        <td>Shoes</td>
        <td>Sneakers, Sports Shoes</td>
        <td>₹1000 - ₹7000</td>
        <td>Available</td>
    </tr>

    <tr>
        <td>
            <img src="https://wildcraft.com/media/mageplaza/blog/post/f/i/five_types_of_luggage_bags.jpg">
        </td>
        <td>Bags</td>
        <td>Travel Bags, School Bags</td>
        <td>₹800 - ₹5000</td>
        <td>Available</td>
    </tr>

    <tr>
        <td>
            <img src="https://www.gonoise.com/cdn/shop/files/Artboard_4_result_bd8eb80f-2271-4244-a58a-7b4d3946346d.webp?v=1749101195">
        </td>
        <td>Watches</td>
        <td>Smart Watch, Analog Watch</td>
        <td>₹2000 - ₹15000</td>
        <td>Available</td>
    </tr>
</table>
     <script>

let slideIndex = 1;
showSlides(slideIndex);

function plusSlides(n){
    showSlides(slideIndex += n);
}

function currentSlide(n){
    showSlides(slideIndex = n);
}

function showSlides(n){

    let i;
    let slides = document.getElementsByClassName("slides");
    let dots = document.getElementsByClassName("dot");

    if(n > slides.length){
        slideIndex = 1;
    }

    if(n < 1){
        slideIndex = slides.length;
    }

    for(i = 0; i < slides.length; i++){
        slides[i].style.display = "none";
    }

    for(i = 0; i < dots.length; i++){
        dots[i].className = dots[i].className.replace(" active", "");
    }

    slides[slideIndex-1].style.display = "block";
    dots[slideIndex-1].className += " active";
}


setInterval(() => {
    plusSlides(1);
}, 3000);

</script>
</body>
</html>
