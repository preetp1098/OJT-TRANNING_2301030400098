<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRODUCT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
    body{
        background-image: url('https://images.unsplash.com/photo-1498049794561-7780e7231661');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        font-family: Arial, sans-serif;
        min-height: 100vh;
        background-color: #f5f5f5;
    }

    h1{
        text-align: center;
        margin-top: 30px;
        margin-bottom: 30px;
        color: #333;
        font-weight: bold;
        letter-spacing: 3px;
        text-shadow: 3px 3px 8px rgba(0,0,0,0.7);
    }

    .row{
        border: 1px solid #ddd;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.1);
        max-width: 700px;
    }

    .row div{
        padding: 15px;
        border: 1px solid #ddd;
        font-size: 18px;
    }

    .row div:nth-child(1),
    .row div:nth-child(2){
        background-color: #0d6efd;
        color: white;
        font-weight: bold;
    }

    .row div:nth-child(n+3){
    background-color: rgba(255,255,255,0.85);
    color: black;
    font-weight: bold;
    }

    .row div:hover{
        background-color: #e9ecef;
        transition: 0.3s;
    }
</style>
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <h1>PRODUCT DETAILS</h1>
        <div class="row">
            <div class="col-md-6">Our Products</div>
            <div class="col-md-6">Price</div>
            <div class="col-md-6">T-shirt</div>
            <div class="col-md-6">$ 2.00</div>
            <div class="col-md-6">Sunglasses</div>
            <div class="col-md-6">$ 5.00</div>
            <div class="col-md-6">Perfume</div>
            <div class="col-md-6">$ 10.00</div>
            <div class="col-md-6">Shoes</div>
            <div class="col-md-6">$ 15.00</div>
        </div>
</body>
</html>
